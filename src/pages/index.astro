---
/**
 * Home (MVP) — porta de reference/home-preview/home-preview.html com as
 * correções de docs/REVISAO-PLANEJAMENTO.md (4.1 e 4.4). Usa só textos que já
 * existem (docs/ANALISE-PROJETO.md, apêndice A); o que depende de dado ainda
 * não informado (fotos, valores, depoimentos, respostas) não aparece.
 */
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import Botao from '../components/Botao.astro';
import Card from '../components/Card.astro';
import Citacao from '../components/Citacao.astro';
import Secao from '../components/Secao.astro';
import Simbolo from '../components/Simbolo.astro';
import { enderecoCompleto, enderecoEmLinhas, linkEmail, linkMapa, linkTelefone, site } from '../config/site';
import { schemaEstudio } from '../lib/schema';

const porOrdem = (a: { data: { ordem: number } }, b: { data: { ordem: number } }) => a.data.ordem - b.data.ordem;

const equipe = (await getCollection('equipe')).sort(porOrdem);
const planos = (await getCollection('planos')).sort(porOrdem);
/** Mais recentes primeiro. */
const depoimentos = (await getCollection('depoimentos')).sort(
  (a, b) => b.data.autorizadoEm.getTime() - a.data.autorizadoEm.getTime()
);
const faq = (await getCollection('faq')).sort(porOrdem).flatMap(({ id, data }) =>
  data.resposta ? [{ id, pergunta: data.pergunta, resposta: data.resposta.replace('{endereco}', enderecoCompleto()) }] : []
);

/** Monograma no lugar da foto, enquanto não houver retratos: "Claudia Carlesso" → "CC". */
function iniciais(nome: string): string {
  const partes = nome.split(/\s+/);
  return `${partes[0][0]}${partes.length > 1 ? partes[partes.length - 1][0] : ''}`;
}

const diferenciais = [
  {
    titulo: 'Pilates Clássico',
    texto: 'O primeiro studio de Pilates Clássico de Foz do Iguaçu, fiel à Contrologia e ao método como ele foi criado.'
  },
  {
    titulo: 'Dueto ou Vip class',
    texto: 'Duas pessoas por horário ou, se você preferir, o sistema individualizado, com atenção total ao seu movimento.'
  },
  {
    titulo: 'Fisioterapeutas na equipe',
    texto: 'Aulas conduzidas por fisioterapeutas, com a responsabilidade técnica de quem atua há mais de 10 anos com o método.'
  }
];
---

<Base titulo={`${site.nome} — Pilates Clássico em Foz do Iguaçu`} schema={schemaEstudio()}>
  <Secao rotulo="Apresentação" class="hero">
    <div class="hero__linha">
      <div class="hero__texto">
        <p class="eyebrow">{site.posicionamento}</p>
        <h1 class="hero__titulo">Mova-se e deixe a magia do método acontecer.</h1>
        <p class="hero__lead">
          Aulas presenciais para duetos e Vip class, conduzidas por fisioterapeutas, em Foz do Iguaçu.
        </p>
        <div class="acoes">
          <Botao whatsapp={{ posicao: 'hero' }} tamanho="lg">Agendar minha aula</Botao>
          <Botao href="#metodo" variante="secundario" tamanho="lg">Conhecer o método</Botao>
        </div>
      </div>
      <!-- Sem foto do estúdio ainda: padronagem da marca no lugar (REVISAO-PLANEJAMENTO, 4.1). -->
      <div class="hero__painel" aria-hidden="true">
        <Simbolo tamanho={320} traco={0.9} class="hero__simbolo" />
      </div>
    </div>
  </Secao>

  <Secao class="diferenciais">
    <h2 class="sr-only">Por que a {site.nome}</h2>
    <ul class="grade lista">
      {
        diferenciais.map(({ titulo, texto }, i) => (
          <Card as="li" class="diferencial">
            <span class="diferencial__numero" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="diferencial__titulo">{titulo}</h3>
            <p class="texto-card">{texto}</p>
          </Card>
        ))
      }
    </ul>
  </Secao>

  <Secao id="metodo" tom="escuro">
    <div class="metodo">
      <div class="metodo__citacao">
        <h2 class="eyebrow">O método</h2>
        <Citacao>
          Pilates te desafia em todos os momentos. Seja no equilíbrio, na força, na mobilidade.
        </Citacao>
      </div>
      <div class="metodo__texto">
        <p>
          Permita-se viver as transformações de dentro para fora. Não somente o corpo, mas sentir e viver a
          sua verdade.
        </p>
        <p>Sinta-se livre para buscar o “seu jeito” dentro da Contrologia.</p>
      </div>
    </div>
  </Secao>

  <Secao id="aulas">
    <p class="eyebrow">Aulas e pacotes</p>
    <h2 class="titulo-secao">Duas formas de praticar.</h2>
    <ul class="grade grade--larga lista">
      {
        planos.map(({ data: plano }) => (
          <Card as="li" class="plano">
            <div>
              <p class="eyebrow eyebrow--destaque">{plano.nome}</p>
              <h3 class="titulo-card">{plano.titulo}</h3>
            </div>
            <p class="plano__descricao">{plano.descricao}</p>
            {plano.frequencia || plano.valor ? (
              <dl class="plano__detalhes">
                {plano.frequencia && (
                  <div>
                    <dt>Frequência semanal</dt>
                    <dd>{plano.frequencia}</dd>
                  </div>
                )}
                {plano.valor && (
                  <div>
                    <dt>Valor</dt>
                    <dd>{plano.valor}</dd>
                  </div>
                )}
              </dl>
            ) : (
              <p class="plano__detalhes">Consulte valores e horários pelo WhatsApp.</p>
            )}
            <Botao whatsapp={{ contexto: plano.contexto, posicao: 'aulas' }} class="plano__cta">
              {plano.cta}
            </Botao>
          </Card>
        ))
      }
    </ul>
  </Secao>

  <Secao id="estudio" tom="papel">
    <div class="estudio">
      <div class="estudio__texto">
        <p class="eyebrow">Nosso espaço</p>
        <h2 class="titulo-secao">Será um prazer recebê-lo no estúdio.</h2>
        <p class="lead">
          Estamos na {site.endereco.bairro}, em {site.endereco.cidade}. Fale com a gente pelo WhatsApp para
          combinar o seu horário.
        </p>
      </div>
      <Card class="estudio__contato">
        <h3 class="eyebrow eyebrow--destaque">Como chegar</h3>
        <address class="estudio__endereco">
          {enderecoEmLinhas().map((linha) => <span>{linha}</span>)}
        </address>
        <ul class="lista estudio__links">
          <li><a href={linkTelefone}>{site.telefone.exibicao}</a></li>
          <li><a href={linkEmail}>{site.email}</a></li>
        </ul>
        <Botao href={linkMapa} variante="secundario" externo>Ver no Google Maps</Botao>
      </Card>
    </div>
  </Secao>

  <Secao id="equipe">
    <p class="eyebrow">Equipe</p>
    <h2 class="titulo-secao">Quem conduz a sua prática.</h2>
    <ul class="grade grade--larga lista">
      {
        equipe.map(({ data: pessoa }) => (
          <Card as="li" class="pessoa">
            <div class="pessoa__monograma" aria-hidden="true">
              {iniciais(pessoa.nome)}
            </div>
            <div class="pessoa__texto">
              <h3 class="titulo-card">{pessoa.nome}</h3>
              <p class="eyebrow eyebrow--destaque pessoa__papel">{pessoa.papel}</p>
              {pessoa.crefito && <p class="pessoa__registro">CREFITO-8 {pessoa.crefito}</p>}
              <p class="texto-card">{pessoa.bio}</p>
            </div>
          </Card>
        ))
      }
    </ul>
  </Secao>

  <Secao id="profissionais" tom="marca">
    <div class="profissionais">
      <div class="profissionais__texto">
        <p class="eyebrow">Para profissionais</p>
        <h2 class="titulo-secao">Mentorias, workshops e treinamentos.</h2>
        <p class="lead">
          Formação para quem trabalha com Pilates, com a experiência de mais de uma década de Claudia Carlesso
          no método.
        </p>
      </div>
      <Botao whatsapp={{ contexto: 'profissionais', posicao: 'profissionais' }} variante="claro" tamanho="lg">
        Falar sobre formação
      </Botao>
    </div>
  </Secao>

  {
    depoimentos.length > 0 && (
      <Secao id="depoimentos" class="depoimentos">
        <p class="eyebrow">Depoimentos</p>
        <h2 class="titulo-secao">O que dizem os alunos.</h2>
        <ul class="grade lista">
          {depoimentos.map(({ data: depoimento }) => (
            <Card as="li" class="depoimento">
              <figure>
                <blockquote class="depoimento__texto">{depoimento.texto}</blockquote>
                <figcaption class="depoimento__autor">{depoimento.autor}</figcaption>
              </figure>
            </Card>
          ))}
        </ul>
      </Secao>
    )
  }

  {
    faq.length > 0 && (
      <Secao id="perguntas" tom="papel" estreita>
        <p class="eyebrow">Perguntas frequentes</p>
        <h2 class="titulo-secao">Antes de agendar.</h2>
        <div class="faq">
          {faq.map(({ pergunta, resposta }) => (
            <details class="faq__item">
              <summary class="faq__pergunta">
                <span>{pergunta}</span>
                <svg class="faq__icone" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M9 2v14M2 9h14" />
                </svg>
              </summary>
              <p class="faq__resposta">{resposta}</p>
            </details>
          ))}
        </div>
      </Secao>
    )
  }

  <Secao rotulo="Agendamento" estreita class="fechamento">
    <h2 class="fechamento__titulo">Venha praticar conosco.</h2>
    <p class="lead fechamento__texto">
      Fale com a gente pelo WhatsApp e escolha o melhor horário para a sua primeira aula.
    </p>
    <Botao whatsapp={{ posicao: 'fechamento' }} tamanho="lg">Agendar minha aula</Botao>
  </Secao>
</Base>

<style>
  /* === Peças comuns da página === */

  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grade {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .grade > :global(*) {
    flex: 1 1 280px;
  }

  .grade--larga {
    gap: 24px;
    margin-top: 48px;
  }

  .grade--larga > :global(*) {
    flex-basis: 400px;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .lead {
    font-size: var(--fs-lead);
    color: var(--tom-text-body);
  }

  .eyebrow--destaque {
    color: var(--tom-accent);
  }

  .titulo-card {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-card-title);
    line-height: 1.1;
  }

  .texto-card {
    font-size: var(--fs-text-sm);
    color: var(--tom-text-body);
  }

  /* === Hero === */

  .hero__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
  }

  .hero__texto {
    flex: 1 1 440px;
    min-width: 0;
  }

  .hero__titulo {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-hero);
    line-height: 1.02;
  }

  .hero__lead {
    margin-top: 28px;
    max-width: 30em;
    font-size: var(--fs-lead);
    color: var(--tom-text-body);
  }

  .hero__painel {
    flex: 1 1 360px;
    max-width: 520px;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-lg);
    background-color: var(--c-azul-soft);
    background-image: url('/brand/pattern-tile.svg');
    background-size: 120px 120px;
  }

  .hero__simbolo {
    width: 72%;
    height: auto;
    color: var(--c-horizonte);
    opacity: 0.28;
  }

  /* Decorativo: no celular só empurraria o conteúdo para baixo. */
  @media (max-width: 767px) {
    .hero__painel {
      display: none;
    }
  }

  /* === Diferenciais === */

  /* Continua o fundo do hero, sem um segundo respiro de seção entre os dois. */
  .secao.diferenciais {
    padding-top: 0;
  }

  .diferencial {
    padding: 36px 32px;
  }

  .diferencial__numero {
    display: block;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
    color: var(--tom-accent);
  }

  .diferencial__titulo {
    margin: 20px 0 10px;
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
  }

  /* === Método === */

  .metodo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
  }

  .metodo__citacao {
    flex: 1 1 420px;
    min-width: 0;
  }

  .metodo__citacao :global(.citacao) {
    margin-top: 28px;
  }

  .metodo__texto {
    flex: 1 1 380px;
    min-width: 0;
    font-size: var(--fs-lead);
    color: var(--tom-text-body);
  }

  .metodo__texto p + p {
    margin-top: 20px;
  }

  /* === Aulas === */

  .plano {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px 36px;
  }

  .plano .titulo-card {
    margin-top: 10px;
  }

  .plano__descricao {
    color: var(--tom-text-body);
  }

  .plano__detalhes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--fs-text-sm);
    color: var(--tom-text-body);
  }

  .plano__detalhes div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .plano__detalhes dd {
    margin: 0;
    font-weight: 500;
    color: var(--tom-text);
  }

  /* Botões alinhados na base dos cards, mesmo com textos de tamanhos diferentes. */
  .plano :global(.plano__cta) {
    align-self: flex-start;
    margin-top: auto;
  }

  /* === Estúdio === */

  .estudio {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px 64px;
  }

  .estudio__texto {
    flex: 1.4 1 420px;
    min-width: 0;
  }

  .estudio__texto .lead {
    margin-top: 24px;
    max-width: 32em;
  }

  .estudio :global(.estudio__contato) {
    flex: 1 1 320px;
    padding: 32px;
  }

  .estudio__endereco {
    display: flex;
    flex-direction: column;
    margin-top: 14px;
    font-style: normal;
    line-height: 1.6;
  }

  .estudio__links {
    margin: 12px 0 20px;
    font-size: var(--fs-text-sm);
    color: var(--tom-text-body);
  }

  .estudio__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  .estudio__links a:hover {
    color: var(--tom-text);
    text-decoration: underline;
  }

  /* === Equipe === */

  .pessoa {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
  }

  .pessoa__monograma {
    flex: 1 1 200px;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--c-azul-soft);
    font-family: var(--font-display);
    font-size: 72px;
    line-height: 1;
    color: var(--c-horizonte);
  }

  /* Empilhado no celular: o monograma é só um respiro, não precisa da altura de uma foto. */
  @media (max-width: 767px) {
    .pessoa__monograma {
      min-height: 160px;
      font-size: 56px;
    }
  }

  .pessoa:nth-child(even) .pessoa__monograma {
    background-color: var(--c-azul-3);
  }

  .pessoa__texto {
    flex: 1.4 1 260px;
    min-width: 0;
    padding: 32px 28px;
  }

  .pessoa__papel {
    margin-top: 8px;
  }

  .pessoa__registro {
    margin-top: 4px;
    font-size: var(--fs-label);
    color: var(--tom-text-body);
  }

  .pessoa .texto-card {
    margin-top: 16px;
  }

  /* === Para profissionais === */

  .profissionais {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .profissionais__texto {
    flex: 1 1 480px;
    min-width: 0;
  }

  .profissionais .titulo-secao {
    font-size: var(--fs-section-sm);
  }

  .profissionais .lead {
    margin-top: 20px;
    max-width: 36em;
  }

  /* === Depoimentos === */

  .depoimentos .grade {
    margin-top: 40px;
  }

  .depoimento {
    padding: 32px;
  }

  .depoimento figure {
    margin: 0;
  }

  .depoimento__texto {
    margin: 0;
    font-family: var(--font-aux);
    font-style: italic;
    font-size: 22px;
    line-height: var(--lh-snug);
  }

  .depoimento__autor {
    margin-top: 20px;
    font-size: var(--fs-text-sm);
    font-weight: 500;
    color: var(--tom-text-body);
  }

  /* === Perguntas frequentes === */

  .faq {
    margin-top: 32px;
    border-bottom: 1px solid var(--border-default);
  }

  .faq__item {
    border-top: 1px solid var(--border-default);
  }

  .faq__pergunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    font-size: var(--fs-lead);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq__pergunta::-webkit-details-marker {
    display: none;
  }

  .faq__icone {
    flex-shrink: 0;
    fill: none;
    stroke: var(--tom-marca);
    stroke-width: 1.5;
    stroke-linecap: round;
    transition: transform 160ms ease;
  }

  .faq__item[open] .faq__icone {
    transform: rotate(45deg);
  }

  .faq__resposta {
    padding-bottom: 24px;
    font-size: var(--fs-text-sm);
    color: var(--tom-text-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icone {
      transition: none;
    }
  }

  /* === Fechamento === */

  .fechamento {
    text-align: center;
  }

  .fechamento__titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-closing);
    line-height: var(--lh-display);
  }

  .fechamento__texto {
    margin: 20px 0 36px;
  }
</style>
